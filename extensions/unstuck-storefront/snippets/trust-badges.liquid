{%- comment -%}
  Trust badges: up to 4 short promises, each with an icon from the app's set.
{%- endcomment -%}
<ul class="unstuck-block unstuck-badges">
  {%- for item in settings.items -%}
    <li class="unstuck-badges__item">
      <svg class="unstuck-badges__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {%- case item.icon -%}
          {%- when 'shipping' -%}
            <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/>
          {%- when 'returns' -%}
            <path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>
          {%- when 'secure' -%}
            <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
          {%- when 'guarantee' -%}
            <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
          {%- when 'support' -%}
            <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z"/>
        {%- endcase -%}
      </svg>
      <span>{{ item.text | escape }}</span>
    </li>
  {%- endfor -%}
</ul>
