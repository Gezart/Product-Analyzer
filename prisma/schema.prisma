// Data model from docs/PLAN.md → "Data model".
// Every store-owned table is reachable from Shop and deleted with it (shop/redact).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Shopify offline session (expiring token + refresh token). Tokens are encrypted at rest.
model Session {
  id                  String    @id
  shop                String    @unique
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  accessToken         String
  expires             DateTime?
  refreshToken        String?
  refreshTokenExpires DateTime?
  updatedAt           DateTime  @updatedAt

  @@map("sessions")
}

model Shop {
  id             String    @id @default(cuid())
  domain         String    @unique
  plan           String    @default("free")
  trialStartedAt DateTime? @map("trial_started_at")
  currency       String?
  timezone       String?
  installedAt    DateTime  @default(now()) @map("installed_at")
  uninstalledAt  DateTime? @map("uninstalled_at")

  settings           Settings?
  products           Product[]
  reports            Report[]
  notifications      Notification[]
  syncStates         SyncState[]
  aiUsage            AiUsage[]
  jobs               Job[]
  orderLines         OrderLine[]
  competitorLinks    CompetitorLink[]
  googleConnection   GoogleConnection?
  googleBenchmarks   GoogleBenchmark[]
  lineRefunds        LineRefund[]
  returnReasons      ReturnReason[]
  aiPhotoDrafts      AiPhotoDraft[]
  collectionReorders CollectionReorder[]
  abTests            AbTest[]
  bundles            Bundle[]

  @@map("shops")
}

model Settings {
  shopId                String   @id @map("shop_id")
  thresholds            Json     @default("{}")
  marginFloorPct        Decimal  @default(10) @map("margin_floor_pct") @db.Decimal(5, 2)
  maxDiscountPct        Decimal  @default(40) @map("max_discount_pct") @db.Decimal(5, 2)
  excludedCollectionIds String[] @default([]) @map("excluded_collection_ids")
  excludedProductIds    String[] @default([]) @map("excluded_product_ids")
  /// When a markdown ends: "restore" the original price or "hold" the last discount.
  markdownEndAction     String   @default("restore") @map("markdown_end_action")
  digestDay             Int      @default(1) @map("digest_day") // 0 = Sunday … 6 = Saturday
  /// Collections whose products sell in a season: `[{ collectionId, from, to }]` (months 1–12).
  seasonalCollections   Json     @default("[]") @map("seasonal_collections")
  /// Page builder: the product page blocks, their order, settings and "Use for" (src/lib/page-builder.js).
  pageBuilder           Json     @default("{}") @map("page_builder")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Product {
  id               String    @id @default(cuid())
  shopId           String    @map("shop_id")
  shopifyGid       String    @map("shopify_gid")
  title            String
  handle           String
  productType      String?   @map("product_type")
  vendor           String?
  collections      String[]  @default([])
  /// Shopify tags (a `season:` tag marks a seasonal product).
  tags             String[]  @default([])
  imageCount       Int       @default(0) @map("image_count")
  descriptionWords Int       @default(0) @map("description_words")
  /// Plain-text description (first 5,000 characters), for page diagnosis.
  description      String?
  seoTitle         String?   @map("seo_title")
  seoDescription   String?   @map("seo_description")
  price            Decimal   @db.Decimal(12, 2)
  compareAtPrice   Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  cost             Decimal?  @db.Decimal(12, 2)
  status           String
  /// Product creation date in Shopify; caps "days without a sale" for new products.
  shopifyCreatedAt DateTime? @map("shopify_created_at")
  /// "Often bought together" last written to the product's `$app.bought_together` metafield (product GIDs).
  boughtTogether   String[]  @default([]) @map("bought_together")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  shop             Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants         Variant[]
  dailyMetrics     ProductDailyMetric[]
  scores           ProductScore[]
  diagnoses        Diagnosis[]
  fixes            Fix[]
  rescuePlans      RescuePlan[]
  markdownPlans    MarkdownPlan[]
  priceChanges     PriceChange[]
  notifications    Notification[]
  competitorLinks  CompetitorLink[]
  googleBenchmarks GoogleBenchmark[]
  aiPhotoDrafts    AiPhotoDraft[]
  risingActions    RisingAction[]
  abTests          AbTest[]
  launchChecks     LaunchCheck[]
  bundles          Bundle[]             @relation("BundleProduct")
  bundlePartners   Bundle[]             @relation("BundlePartner")

  @@unique([shopId, shopifyGid])
  @@index([shopId])
  @@map("products")
}

model Variant {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  shopifyGid   String   @map("shopify_gid")
  sku          String?
  options      Json     @default("{}")
  price        Decimal  @db.Decimal(12, 2)
  cost         Decimal? @db.Decimal(12, 2)
  inventoryQty Int      @default(0) @map("inventory_qty")
  /// Can still be bought at 0 stock (inventory not tracked, or "continue selling when out of stock").
  sellsWhenOut Boolean  @default(false) @map("sells_when_out")

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceChanges PriceChange[]

  @@unique([productId, shopifyGid])
  @@map("variants")
}

model ProductDailyMetric {
  productId        String   @map("product_id")
  date             DateTime @db.Date
  units            Int      @default(0)
  revenue          Decimal  @default(0) @db.Decimal(14, 2)
  viewSessions     Int      @default(0) @map("view_sessions")
  cartSessions     Int      @default(0) @map("cart_sessions")
  purchaseSessions Int      @default(0) @map("purchase_sessions")
  inventoryQty     Int      @default(0) @map("inventory_qty")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, date])
  @@map("product_daily_metrics")
}

model ProductScore {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  computedAt     DateTime @default(now()) @map("computed_at")
  status         String
  moneyAtStake   Decimal  @map("money_at_stake") @db.Decimal(14, 2)
  stockValue     Decimal  @default(0) @map("stock_value") @db.Decimal(14, 2)
  costIsEstimate Boolean  @default(false) @map("cost_is_estimate")
  sellThrough    Decimal? @map("sell_through") @db.Decimal(6, 4)
  daysOfCover    Decimal? @map("days_of_cover") @db.Decimal(10, 2)
  trend          Decimal? @db.Decimal(10, 4)
  /// Rising star: sales up 20%+ over the 30 days before (see `isRisingStar`).
  rising         Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, computedAt])
  @@map("product_scores")
}

model Diagnosis {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  createdAt    DateTime @default(now()) @map("created_at")
  reasons      Json // [{ code, evidence, severity }]
  aiSummary    String?  @map("ai_summary")
  modelVersion String?  @map("model_version")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fixes   Fix[]

  @@index([productId, createdAt])
  @@map("diagnoses")
}

model Fix {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  diagnosisId String?   @map("diagnosis_id")
  type        String // title | description | seo | images | collection | photo | position
  before      Json
  after       Json
  status      String    @default("suggested") // suggested | approved | applied | undone | failed
  appliedAt   DateTime? @map("applied_at")
  undoneAt    DateTime? @map("undone_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  diagnosis Diagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("fixes")
}

model RescuePlan {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  fixIds    String[]  @default([]) @map("fix_ids")
  startedAt DateTime  @map("started_at")
  endsAt    DateTime? @map("ends_at")
  baseline  Json?
  result    Json?
  verdict   String? // improved | no_change | worse | not_enough_data | cancelled

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  markdownPlans MarkdownPlan[]

  @@index([productId, startedAt])
  @@map("rescue_plans")
}

model MarkdownPlan {
  id             String    @id @default(cuid())
  productId      String    @map("product_id")
  rescuePlanId   String?   @map("rescue_plan_id")
  /// Per-variant ladder: original price/compare-at, floor and the price at each step.
  steps          Json
  /// Lowest floor across the plan's variants (each variant's own floor is in `steps`).
  floorPrice     Decimal   @map("floor_price") @db.Decimal(12, 2)
  maxDiscountPct Decimal   @map("max_discount_pct") @db.Decimal(5, 2)
  status         String // active | paused | completed | cancelled | failed
  /// Ladder step currently live (-1 = none yet).
  currentStep    Int       @default(-1) @map("current_step")
  /// Units in stock when the plan started (stop at 50% sold).
  startStock     Int       @default(0) @map("start_stock")
  /// At the end: "restore" the original prices or "hold" the last step.
  endAction      String    @default("restore") @map("end_action")
  /// Why it ended: stock_cleared | ladder_finished | cancelled.
  endReason      String?   @map("end_reason")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rescuePlan RescuePlan? @relation(fields: [rescuePlanId], references: [id], onDelete: SetNull)

  @@index([productId, startedAt])
  @@map("markdown_plans")
}

model PriceChange {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  variantId    String?  @map("variant_id")
  oldPrice     Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice     Decimal  @map("new_price") @db.Decimal(12, 2)
  oldCompareAt Decimal? @map("old_compare_at") @db.Decimal(12, 2)
  newCompareAt Decimal? @map("new_compare_at") @db.Decimal(12, 2)
  reason       String // markdown | restore | guard_revert
  planId       String?  @map("plan_id")
  variantGid   String?  @map("variant_gid")
  /// Lowest allowed price at the time; the database refuses a markdown below it (CHECK constraint).
  floorPrice   Decimal? @map("floor_price") @db.Decimal(12, 2)
  /// pending (logged, about to be written) | applied | failed
  status       String   @default("pending")
  error        String?
  changedAt    DateTime @default(now()) @map("changed_at")

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, changedAt])
  @@index([planId, status])
  @@map("price_changes")
}

model Report {
  id                String  @id @default(cuid())
  shopId            String  @map("shop_id")
  period            String // e.g. 2026-10
  revenueRecovered  Decimal @default(0) @map("revenue_recovered") @db.Decimal(14, 2)
  stockValueCleared Decimal @default(0) @map("stock_value_cleared") @db.Decimal(14, 2)
  productsRescued   Int     @default(0) @map("products_rescued")
  payload           Json    @default("{}")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, period])
  @@map("reports")
}

model Notification {
  id        String    @id @default(cuid())
  shopId    String    @map("shop_id")
  type      String
  productId String?   @map("product_id")
  /// Details for the message (counts, verdict); the text is built when the inbox is read.
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("notifications")
}

model SyncState {
  shopId       String    @map("shop_id")
  resource     String
  lastCursor   String?   @map("last_cursor")
  lastSyncedAt DateTime? @map("last_synced_at")
  status       String    @default("idle")
  error        String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, resource])
  @@map("sync_state")
}

model AiUsage {
  shopId       String  @map("shop_id")
  month        String // e.g. 2026-10
  calls        Int     @default(0)
  inputTokens  Int     @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  costUsd      Decimal @default(0) @map("cost_usd") @db.Decimal(10, 4)
  /// AI photos made this month (their own limit) and what they cost; the columns above are descriptions.
  photoCalls   Int     @default(0) @map("photo_calls")
  photoCostUsd Decimal @default(0) @map("photo_cost_usd") @db.Decimal(10, 4)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, month])
  @@map("ai_usage")
}

/// A photo made with AI, waiting for the merchant to add it to the product (or not). The image is kept
/// until then (drafts older than a day are removed); once added, `mediaId` is the photo in Shopify.
model AiPhotoDraft {
  id            String   @id @default(cuid())
  shopId        String   @map("shop_id")
  productId     String   @map("product_id")
  sourceMediaId String   @map("source_media_id")
  style         String // white | scene
  scene         String?
  image         Bytes?
  mimeType      String   @map("mime_type")
  status        String   @default("draft") // draft | adding | added | discarded
  mediaId       String?  @map("media_id")
  fixId         String?  @map("fix_id")
  createdAt     DateTime @default(now()) @map("created_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([productId, status])
  @@map("ai_photo_drafts")
}

// Background job queue (see src/lib/jobs). Claimed with FOR UPDATE SKIP LOCKED; one running job per shop.
model Job {
  id          String    @id @default(cuid())
  shopId      String?   @map("shop_id")
  type        String
  payload     Json      @default("{}")
  status      String    @default("queued") // queued | running | done | failed
  /// Dedupe key: enqueueing the same key twice is a no-op (e.g. one nightly run per shop per day).
  uniqueKey   String?   @unique @map("unique_key")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([shopId, status])
  @@map("jobs")
}

// Order lines without any customer data (date, product, variant, quantity, revenue). Daily sales in
// product_daily_metrics are rebuilt from these, so repeated or out-of-order webhooks stay correct.
model OrderLine {
  shopId         String   @map("shop_id")
  lineGid        String   @map("line_gid")
  orderGid       String   @map("order_gid")
  productGid     String   @map("product_gid")
  variantGid     String?  @map("variant_gid")
  /// Order date in the store's timezone.
  date           DateTime @db.Date
  quantity       Int
  revenue        Decimal  @db.Decimal(14, 2)
  orderUpdatedAt DateTime @map("order_updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, lineGid])
  @@index([shopId, orderGid])
  @@index([shopId, productGid, date])
  @@map("order_lines")
}

/// A competitor's page for the same product. Its price is read when the link is added and every night.
model CompetitorLink {
  id        String    @id @default(cuid())
  shopId    String    @map("shop_id")
  productId String    @map("product_id")
  url       String
  host      String
  /// Lowest price found on the page, in `currency` (null until read, or when reading failed).
  price     Decimal?  @db.Decimal(12, 2)
  currency  String?
  /// "pending" until the first read, then "ok" or "failed" (with `error`).
  status    String    @default("pending")
  error     String?
  checkedAt DateTime? @map("checked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([shopId])
  @@map("competitor_links")
}

/// Google Merchant Center connection for the market price (one per shop).
model GoogleConnection {
  shopId         String    @id @map("shop_id")
  /// OAuth refresh token, encrypted (src/lib/crypto.js). Access tokens are never stored.
  refreshToken   String?   @map("refresh_token")
  accountId      String?   @map("account_id")
  accountName    String?   @map("account_name")
  /// pending (consent not finished) | choose_account | connected | failed
  status         String    @default("pending")
  error          String?
  /// Single-use OAuth state while Google's consent screen is open (10 minutes).
  oauthState     String?   @unique @map("oauth_state")
  stateExpiresAt DateTime? @map("state_expires_at")
  syncedAt       DateTime? @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("google_connections")
}

/// Google's price benchmark for one offer (a variant) in one country, from the price competitiveness report.
model GoogleBenchmark {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  productId String   @map("product_id")
  offerId   String   @map("offer_id")
  country   String
  price     Decimal  @db.Decimal(12, 2)
  benchmark Decimal  @db.Decimal(12, 2)
  currency  String
  createdAt DateTime @default(now()) @map("created_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, offerId, country])
  @@index([productId])
  @@map("google_benchmarks")
}

/// Units refunded per order line after shipping (returns; cancellations of unshipped items aren't counted)
/// and the money refunded for them. Counted against the order's date, like sales.
model LineRefund {
  shopId         String   @map("shop_id")
  lineGid        String   @map("line_gid")
  orderGid       String   @map("order_gid")
  productGid     String   @map("product_gid")
  /// Order date in the store's timezone.
  date           DateTime @db.Date
  returnedQty    Int      @map("returned_qty")
  refundedAmount Decimal  @map("refunded_amount") @db.Decimal(14, 2)
  orderUpdatedAt DateTime @map("order_updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, lineGid])
  @@index([shopId, orderGid])
  @@index([shopId, productGid, date])
  @@map("line_refunds")
}

/// Why an item was returned (Shopify returns; needs `read_returns`). One row per return line.
model ReturnReason {
  shopId         String   @map("shop_id")
  returnLineGid  String   @map("return_line_gid")
  orderGid       String   @map("order_gid")
  lineGid        String   @map("line_gid")
  productGid     String   @map("product_gid")
  /// Order date in the store's timezone.
  date           DateTime @db.Date
  quantity       Int
  /// Stable reason handle, e.g. "too-small"; `reasonName` is how Shopify shows it.
  reason         String
  reasonName     String   @map("reason_name")
  /// The return's status: REQUESTED or OPEN can still be declined or cancelled (re-checked nightly).
  returnStatus   String   @default("CLOSED") @map("return_status")
  orderUpdatedAt DateTime @map("order_updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, returnLineGid])
  @@index([shopId, orderGid])
  @@index([shopId, productGid, date])
  @@map("return_reasons")
}

/// A collection order saved to Shopify by the Collection Optimizer (products as Shopify GIDs, in order).
/// Undo writes `before` back.
model CollectionReorder {
  id              String    @id @default(cuid())
  shopId          String    @map("shop_id")
  collectionGid   String    @map("collection_gid")
  collectionTitle String    @map("collection_title")
  before          String[]
  after           String[]
  status          String    @default("applying") // applying | applied | undoing | undone | failed
  error           String?
  /// When the running save or undo started; one running longer than 2 min has crashed. At most one
  /// change per collection runs at a time (partial unique index in the migration).
  claimedAt       DateTime  @default(now()) @map("claimed_at")
  appliedAt       DateTime? @map("applied_at")
  undoneAt        DateTime? @map("undone_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, collectionGid, createdAt])
  @@map("collection_reorders")
}

/// Something done for a rising star (moved up in a collection, featured on the home page, restocked),
/// measured by its sales since (units per day) against the 30 days before. Never a rescue verdict.
model RisingAction {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  kind      String // collections | home | stock
  /// The store's day the measurement starts (the day of the action).
  startedOn DateTime @map("started_on") @db.Date
  /// Recorded by a saved collection order (undone with it); null when the merchant pressed "Done".
  reorderId String?  @map("reorder_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Two requests at once (double click, a save and a click) can't record the same action twice.
  @@unique([productId, kind, startedOn])
  @@index([productId, startedOn])
  @@map("rising_actions")
}

/// An A/B test on a product page (docs/TASKS.md, Phase 3b): half the visitors see version B of the
/// title, description or photo order. `a` and `b` are fix states (src/lib/fixes.js); "Use B now"
/// applies `b` as a fix. At most one test per product starts, runs or is applied at a time (partial
/// unique index in the migration).
model AbTest {
  id         String    @id @default(cuid())
  shopId     String    @map("shop_id")
  productId  String    @map("product_id")
  kind       String // title | description | images
  a          Json
  b          Json
  /// Photo previews at the start (`{ [mediaGid]: url }`), for the list of tests.
  previews   Json      @default("{}")
  status     String    @default("starting") // starting | running | ended | applying | applied
  /// Whether the storefront metafield is (still) set; an ended test's is removed, retried until it is.
  published  Boolean   @default(false)
  /// b_better | a_better | time | stopped | changed | plan | product_gone | used_b
  endReason  String?   @map("end_reason")
  winner     String? // a | b
  /// The numbers when it ended (`testStats`).
  result     Json?
  fixId      String?   @map("fix_id")
  /// When "Use B now" claimed it ("applying"); one older than a few minutes crashed.
  claimedAt  DateTime? @map("claimed_at")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitors  AbTestVisitor[]
  purchases AbTestPurchase[]

  @@index([shopId, status])
  @@index([productId])
  @@map("ab_tests")
}

/// A visitor counted in a test (a random id from the storefront, only with tracking consent; no
/// customer data). The version comes from the ids (`variantOf`), never from the storefront.
model AbTestVisitor {
  testId    String    @map("test_id")
  visitorId String    @map("visitor_id")
  variant   String // a | b
  viewedAt  DateTime  @default(now()) @map("viewed_at")
  cartedAt  DateTime? @map("carted_at")

  test AbTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([testId, visitorId])
  @@index([testId, variant])
  @@map("ab_test_visitors")
}

/// An order line of the tested product bought by a counted visitor (its line item property), with its
/// quantity now (0 once cancelled or removed) and revenue.
model AbTestPurchase {
  testId    String   @map("test_id")
  lineGid   String   @map("line_gid")
  orderGid  String   @map("order_gid")
  visitorId String   @map("visitor_id")
  variant   String
  quantity  Int
  revenue   Decimal  @db.Decimal(14, 2)
  orderedAt DateTime @map("ordered_at")

  test AbTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([testId, lineGid])
  @@index([testId, variant])
  @@map("ab_test_purchases")
}

/// A new product's launch checkpoint (day 7, 14 or 30 since it was created): how it was doing then
/// against the store (src/lib/launches.js). Recorded once per checkpoint.
model LaunchCheck {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  day       Int
  /// strong | on_track | page_problem | no_traffic | not_enough_data
  status    String
  /// The numbers then: `{ views, carts, buyers, units, revenue, cartRate, storeCartRate, reason }`.
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, day])
  @@map("launch_checks")
}

/// "Buy together −X%" (docs/TASKS.md, Phase 3c): a stuck product (`productId`) at `pct`% off for shoppers
/// who buy a product that sells well (`partnerId`), as a Shopify automatic discount (`discountGid`) and
/// an offer on the partner's page (its `$app.bundle` metafields). At most one running bundle per product
/// on either side (partial unique indexes in the migration).
model Bundle {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  productId   String    @map("product_id")
  partnerId   String    @map("partner_id")
  pct         Int
  /// The Shopify discount's title (shoppers see it in the cart); also finds a discount whose id was lost.
  title       String
  discountGid String?   @map("discount_gid")
  status      String    @default("starting") // starting | active | ended
  /// Whether the discount or the offer may still be live in Shopify after it ended (retried nightly).
  cleanup     Boolean   @default(false)
  /// stopped | sold_out | product_gone | floor | plan
  endReason   String?   @map("end_reason")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation("BundleProduct", fields: [productId], references: [id], onDelete: Cascade)
  partner Product @relation("BundlePartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@map("bundles")
}
