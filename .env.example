# Shopify Partner Dashboard → App → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_orders
# Public HTTPS URL of the app (tunnel in development)
SHOPIFY_APP_URL=https://your-tunnel.example.com

# Supabase (project xkiccjxmxugoiswywqbm) → Connect → Connection string
# Runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xkiccjxmxugoiswywqbm:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Migrations: session pooler or direct connection (port 5432)
DIRECT_URL=postgresql://postgres.xkiccjxmxugoiswywqbm:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Test charges are always on outside production. In production, true = test charges.
SHOPIFY_BILLING_TEST=false

# Background jobs (store import, nightly analysis): run the worker inside this server.
# true in local development and on the always-on server; without it nothing is imported.
JOBS_WORKER=true
# Secret for POST /api/jobs/run (external cron alternative): openssl rand -hex 32
CRON_SECRET=
